diff --git a/src/auth/rate-limit.ts b/src/auth/rate-limit.ts
new file mode 100644
--- /dev/null
+++ b/src/auth/rate-limit.ts
+const VENTANA_MS = 15 * 60 * 1000
+const MAX_INTENTOS = 5
+
+const intentos = new Map<string, { count: number; firstAt: number }>()
+
+export function registerAttempt(email: string, now = Date.now()): number {
+  const actual = intentos.get(email)
+  if (!actual || now - actual.firstAt > VENTANA_MS) {
+    intentos.set(email, { count: 1, firstAt: now })
+    return 1
+  }
+  actual.count += 1
+  return actual.count
+}
+
+export function isRateLimited(email: string, now = Date.now()): boolean {
+  const actual = intentos.get(email)
+  if (!actual) return false
+  if (now - actual.firstAt > VENTANA_MS) return false
+  return actual.count > MAX_INTENTOS
+}
+
+export function retryAfterSeconds(email: string, now = Date.now()): number {
+  const actual = intentos.get(email)
+  if (!actual) return 0
+  return Math.max(0, Math.ceil((actual.firstAt + VENTANA_MS - now) / 1000))
+}
+
+export function clearAttempts(email: string): void {
+  intentos.delete(email)
+}

diff --git a/src/auth/login.ts b/src/auth/login.ts
--- a/src/auth/login.ts
+++ b/src/auth/login.ts
+import { clearAttempts, isRateLimited, registerAttempt, retryAfterSeconds } from './rate-limit.ts'
+
 export async function login(email: string, password: string): Promise<Session> {
+  if (isRateLimited(email)) {
+    throw new HttpError(429, 'Demasiados intentos', { 'Retry-After': String(retryAfterSeconds(email)) })
+  }
+  registerAttempt(email)
-  return authenticate(email, password)
+  const session = await authenticate(email, password)
+  clearAttempts(email)
+  return session
 }

